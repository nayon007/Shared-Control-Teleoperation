<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sc_teleop</name>
  <version>0.1.0</version>
  <description>
    Shared-control teleoperation nodes: operator input (DualSense, keyboard or
    scripted), constraint estimator, guidance fixture, haptic output and trial
    logging. Launch files for the sim and the experiments.
  </description>
  <maintainer email="53692178+nayon007@users.noreply.github.com">Md Hafizur Rahman</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sc_core</exec_depend>
  <exec_depend>sc_control</exec_depend>
  <exec_depend>sc_gazebo</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
