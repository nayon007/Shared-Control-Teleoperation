<?xml version="1.0" encoding="utf-8"?>
<!-- FR3 + Franka Hand for the shared-control project.
     Reuses the official franka_description (2.9.0) and adds ros2_control
     tags for Gazebo Classic (effort-controlled arm, position-held fingers). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

  <!-- fr3, fr3v2 or fr3v2_1: must match the lab robot -->
  <xacro:arg name="robot_type" default="fr3"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="controllers_file" default="$(find sc_description)/config/ros2_controllers.yaml"/>
  <!-- Start configuration [rad]; default: gripper pointing horizontally forward -->
  <xacro:arg name="initial_positions_file" default="$(find sc_description)/config/initial_positions.yaml"/>

  <xacro:property name="robot_type" value="$(arg robot_type)"/>
  <xacro:property name="q0" value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}"/>

  <xacro:include filename="$(find franka_description)/robots/common/franka_robot.xacro"/>
  <xacro:franka_robot robot_type="${robot_type}" hand="true" ee_id="franka_hand"
                      rpy_ee="0 0 ${-pi/4}" connected_to="world"/>

  <xacro:if value="$(arg sim_gazebo)">
    <ros2_control name="FR3GazeboSystem" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <xacro:macro name="arm_joint" params="n">
        <joint name="${robot_type}_joint${n}">
          <command_interface name="effort"/>
          <state_interface name="position">
            <param name="initial_value">${q0['joint' + str(n)]}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>
      <xacro:arm_joint n="1"/>
      <xacro:arm_joint n="2"/>
      <xacro:arm_joint n="3"/>
      <xacro:arm_joint n="4"/>
      <xacro:arm_joint n="5"/>
      <xacro:arm_joint n="6"/>
      <xacro:arm_joint n="7"/>
      <!-- Fingers only hold a fixed opening; the grasp itself is a weld (step 3). -->
      <joint name="${robot_type}_finger_joint1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${q0['finger']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${robot_type}_finger_joint2">
        <param name="mimic">${robot_type}_finger_joint1</param>
        <param name="multiplier">1</param>
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${q0['finger']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
