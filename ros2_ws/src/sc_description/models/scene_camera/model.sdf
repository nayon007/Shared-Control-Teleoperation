<?xml version="1.0"?>
<!-- Fixed scene camera = the operator's rendered view (paper block 10).
     Looks at the workspace in front of the FR3; publishes
     /scene_camera/image_raw. Pose is set when spawning (gazebo.launch.py). -->
<sdf version="1.6">
  <model name="scene_camera">
    <static>true</static>
    <link name="link">
      <sensor name="camera" type="camera">
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>1280</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20</far></clip>
        </camera>
        <plugin name="scene_camera" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>scene_camera</camera_name>
          <frame_name>scene_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
